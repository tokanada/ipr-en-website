:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; connect-src https://api.github.com; img-src 'self' data:; style-src 'self'; script-src 'self'"
	}

	@static path *.css *.js *.svg
	header @static Cache-Control "public, max-age=86400"

	@html {
		not path *.css *.js *.svg
	}
	header @html Cache-Control "no-cache"

	file_server
}
